# Build-time API Keys (Optional - all open data endpoints work without keys)
# The Guardian Open Platform API Key (https://open-platform.theguardian.com/access/)
GUARDIAN_API_KEY=

# The New York Times Developer API Key (https://developer.nytimes.com/)
NYT_API_KEY=

# NASA Open APIs Key (https://api.nasa.gov/) - Defaults to DEMO_KEY if not provided
NASA_API_KEY=DEMO_KEY

